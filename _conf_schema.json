{
  "api_base": {
    "type": "string",
    "description": "Sn_OCR 服务地址",
    "default": "http://127.0.0.1:5000",
    "hint": "插件会请求地址下的 /api/v1/ocr"
  },
  "api_token": {
    "type": "string",
    "description": "SN_OCR_API_TOKEN",
    "default": "",
    "hint": "C85X2KJIKL72AqZWIr19qg=="
  },
  "timeout": {
    "type": "int",
    "description": "单次请求超时（秒）",
    "default": 180
  },
  "max_images": {
    "type": "int",
    "description": "单条消息最多提交的图片数",
    "default": 20
  },
  "image_wait_seconds": {
    "type": "int",
    "description": "未附带图片时，等待下一条图片的秒数",
    "default": 120,
    "hint": "适用于微信等不能同时发送文字和图片的平台。0 表示关闭，最大 1800 秒。"
  },
  "deploy_enabled": {
    "type": "bool",
    "description": "允许管理员使用 /snupdate 更新仓库并重启",
    "default": true
  },
  "deploy_repo": {
    "type": "string",
    "description": "Sn_OCR 仓库目录",
    "default": "/opt/Sn_OCR"
  },
  "deploy_service": {
    "type": "string",
    "description": "systemd 服务名",
    "default": "sn_ocr"
  },
  "deploy_use_sudo": {
    "type": "bool",
    "description": "重启时使用 sudo -n systemctl（需要免密 sudo）",
    "default": false
  },
  "deploy_user_ids": {
    "type": "string",
    "description": "允许更新的用户 ID，逗号分隔。留空表示所有 AstrBot 管理员",
    "default": ""
  }
}
